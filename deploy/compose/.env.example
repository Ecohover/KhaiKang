# Docker Hub images. Use a fixed released version in production, not latest.
KHAIKANG_API_IMAGE=ecohover/khaikang-api
KHAIKANG_WEB_IMAGE=ecohover/khaikang-web
KHAIKANG_IMAGE_TAG=latest
# Local HTTP port. For HTTPS production, keep this internal and use a TLS reverse proxy.
KHAIKANG_HTTP_PORT=8080
# Set true only when users access KhaiKang through HTTPS.
KHAIKANG_REQUIRE_HTTPS=false

# PostgreSQL. Replace the password with a long random value. Avoid spaces and semicolons.
POSTGRES_DB=khaikang
POSTGRES_USER=khaikang
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
